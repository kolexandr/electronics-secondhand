<% content_for :title, "Browse electronics · Regear" %>
<section class="hero">
  <div><p class="eyebrow">Less waste. More possibility.</p><h1>Your next project<br>starts here.</h1><p>Pre-owned boards, components, and everyday electronics.<br>Find something worth putting back to work.</p></div>
  <%= link_to "Have something to sell? →", new_listing_path, class: "hero-link" %>
</section>
<%= form_with url: listings_path, method: :get, class: "filters" do |form| %>
  <div class="search-field"><%= form.label :q, "Search" %><%= form.search_field :q, value: @filters["q"], placeholder: "Router, Raspberry Pi, graphics card…" %></div>
  <div><%= form.label :category_id, "Category" %><%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, @filters["category_id"]), include_blank: "All categories" %></div>
  <div><%= form.label :condition %><%= form.select :condition, Listing::CONDITIONS.map { |value, label| [label, value] }, include_blank: "Any condition", selected: @filters["condition"] %></div>
  <div><%= form.label :min_price, "Min €" %><%= form.number_field :min_price, value: @filters["min_price"], min: 0, max: 999999.99, step: "0.01", placeholder: "0" %></div>
  <div><%= form.label :max_price, "Max €" %><%= form.number_field :max_price, value: @filters["max_price"], min: 0, max: 999999.99, step: "0.01", placeholder: "Any" %></div>
  <div><%= form.label :sort, "Sort by" %><%= form.select :sort, [["Newest first", "newest"], ["Price: low to high", "price_low"], ["Price: high to low", "price_high"], ["Oldest first", "oldest"]], selected: @filters["sort"] %></div>
  <%= form.submit "Find items" %><%= link_to "Reset", listings_path, class: "reset-link" %>
<% end %>
<% @filter_errors.each do |message| %><div class="flash alert" role="alert"><%= message %></div><% end %>
<div class="section-heading"><h2>Available finds</h2><span><%= pluralize(@total, "item") %></span></div>
<%= render "collection" %>

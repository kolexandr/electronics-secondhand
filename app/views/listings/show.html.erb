<% content_for :title, "#{@listing.title} · Regear" %>
<%= link_to "← Browse listings", listings_path, class: "back-link" %>
<article class="listing-detail">
  <div class="detail-image"><% if @listing.photo.attached? %><%= image_tag @listing.photo, alt: @listing.title %><% end %></div>
  <div class="detail-info">
    <p class="eyebrow"><%= @listing.category.name %></p>
    <h1><%= @listing.title %></h1>
    <div class="badges"><span class="badge"><%= Listing::CONDITIONS[@listing.condition] %></span><span class="badge"><%= @listing.status.humanize %></span></div>
    <p class="detail-price"><%= euro_price(@listing) %></p>
    <div class="description"><%= simple_format(@listing.description) %></div>
    <p class="seller">Listed by <strong><%= @listing.seller.display_name %></strong></p>
    <% if authenticated? && Current.user.id == @listing.seller_id && @listing.available? %>
      <div class="actions"><%= link_to "Edit listing", edit_listing_path(@listing), class: "button" %><%= button_to "Remove listing", @listing, method: :delete, class: "button danger", data: { turbo_confirm: "Remove this listing?" } %></div>
    <% end %>
    <section class="purchase-panel" aria-label="Purchase options">
      <% if @listing.sold? %>
        <p>This item has been sold.</p>
      <% elsif authenticated? && Current.user.id == @listing.seller_id %>
        <p>This is your listing. Buyers can reserve it for 15 minutes.</p>
      <% elsif @active_reservation&.valid_for_checkout? %>
        <% if authenticated? && @active_reservation.buyer_id == Current.user.id %>
          <%= link_to "View your reservation", reservation_path(@active_reservation), class: "button" %>
        <% else %>
          <p>Another buyer has reserved this item. Check back after <%= time_tag @active_reservation.expires_at, utc_time(@active_reservation.expires_at) %>.</p>
        <% end %>
      <% elsif @listing.available? || @active_reservation&.display_status == "expired" %>
        <p>Reserve this item for 15 minutes before completing a simulated purchase.</p>
        <% if authenticated? %>
          <%= button_to "Reserve for #{euro_price(@listing)}", listing_reservations_path(@listing), class: "button" %>
        <% else %>
          <%= link_to "Sign in to reserve", new_session_path, class: "button" %>
        <% end %>
        <small>No real payment or shipping is involved.</small>
      <% else %>
        <p>This item is currently unavailable.</p>
      <% end %>
    </section>
  </div>
</article>

<% content_for :title, "Sign in · Regear" %>
<section class="auth-panel">
  <p class="eyebrow">Welcome back</p>
  <h1>Sign in</h1>
  <%= form_with url: session_path do |form| %>
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", value: params[:email_address] %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    <%= form.submit "Sign in" %>
  <% end %>
  <p><%= link_to "Forgot your password?", new_password_path %></p>
  <p>New here? <%= link_to "Create an account", new_registration_path %></p>
</section>
